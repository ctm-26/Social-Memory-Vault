{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://christophertmoore.com/schemas/signal-contract-v0.1.json",
  "title": "Signal Kernel Contract v0.1",
  "description": "A provenance-preserving path from source to claim to event to project impact to candidate action.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "signal_id",
    "captured_at",
    "source",
    "claim",
    "event",
    "project_impact",
    "candidate_action"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "signal_id": {
      "type": "string",
      "pattern": "^sig_[a-z0-9][a-z0-9_-]{2,63}$"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "claim": {
      "$ref": "#/$defs/claim"
    },
    "event": {
      "$ref": "#/$defs/event"
    },
    "project_impact": {
      "$ref": "#/$defs/projectImpact"
    },
    "candidate_action": {
      "$ref": "#/$defs/candidateAction"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,63}$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "publisher",
        "url",
        "published_at",
        "retrieved_at",
        "content_hash",
        "evidence_excerpt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "publisher": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "published_at": {
          "type": "string",
          "format": "date-time"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "evidence_excerpt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_id",
        "text",
        "status",
        "confidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "source_id": {
          "$ref": "#/$defs/identifier"
        },
        "text": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "status": {
          "enum": [
            "confirmed",
            "inferred",
            "disputed",
            "superseded"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "summary",
        "occurred_at",
        "claim_ids"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "summary": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "claim_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "projectImpact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "project_name",
        "impact_summary",
        "event_ids"
      ],
      "properties": {
        "project_id": {
          "$ref": "#/$defs/identifier"
        },
        "project_name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "impact_summary": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "event_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "candidateAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "rationale",
        "event_ids",
        "affected_project_ids",
        "human_approval_required",
        "reversibility",
        "urgency",
        "expires_at",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "rationale": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "event_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "affected_project_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "human_approval_required": {
          "type": "boolean"
        },
        "reversibility": {
          "enum": [
            "reversible",
            "partially_reversible",
            "irreversible"
          ]
        },
        "urgency": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "const": "candidate"
        }
      }
    }
  }
}
